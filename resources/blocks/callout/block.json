{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sage/callout",
  "title": "Callout",
  "category": "text",
  "icon": "megaphone",
  "description": "A highlighted message styled as a Bootstrap alert.",
  "textdomain": "sage",
  "attributes": {
    "message": {
      "type": "string",
      "default": ""
    },
    "variant": {
      "type": "string",
      "enum": ["primary", "secondary", "success", "info", "warning", "danger", "light", "dark"],
      "default": "primary"
    }
  },
  "supports": {
    "html": false
  }
}
